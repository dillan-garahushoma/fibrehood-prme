{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person requesting a connection or contact."
    },
    "phone": {
      "type": "string",
      "description": "Primary contact phone number."
    },
    "alt_phone": {
      "type": "string",
      "description": "Alternate contact number for installation."
    },
    "email": {
      "type": "string",
      "description": "Optional contact email address."
    },
    "address": {
      "type": "string",
      "description": "Resolved location label for the enquiry."
    },
    "segment": {
      "type": "string",
      "enum": [
        "home",
        "business",
        "unsure"
      ],
      "default": "unsure",
      "description": "Whether the enquiry is for home or business connectivity."
    },
    "intent": {
      "type": "string",
      "enum": [
        "install_request",
        "notify_when_live",
        "register_interest",
        "contact"
      ],
      "default": "register_interest",
      "description": "What the customer asked for, derived from their coverage status."
    },
    "reference": {
      "type": "string",
      "description": "Customer-facing reference number (FH-XXXXXX)."
    },
    "selected_plan": {
      "type": "string",
      "description": "Identifier of the plan the lead selected, if any."
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "LIVE",
        "IN_PROGRESS",
        "PLANNED",
        "NOT_STARTED"
      ],
      "description": "Canonical FibreHood deployment status at the resolved location."
    },
    "resolution": {
      "type": "string",
      "enum": [
        "EXACT",
        "AREA",
        "NEARBY",
        "NOT_FOUND"
      ],
      "description": "How precisely the customer's location was resolved."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "Confidence in the location match."
    },
    "latitude": {
      "type": "number",
      "description": "Resolved latitude \u2014 used for expansion heatmapping."
    },
    "longitude": {
      "type": "number",
      "description": "Resolved longitude \u2014 used for expansion heatmapping."
    },
    "town_id": {
      "type": "string",
      "description": "Town identifier from the location hierarchy."
    },
    "suburb_id": {
      "type": "string",
      "description": "Suburb identifier from the location hierarchy."
    },
    "area_id": {
      "type": "string",
      "description": "Matched coverage area identifier."
    },
    "mdu_id": {
      "type": "string",
      "description": "Matched multi-dwelling unit identifier, where known."
    },
    "order_type": {
      "type": "string",
      "enum": [
        "new_installation",
        "migration"
      ],
      "description": "New installation or migration of an existing fibre line."
    },
    "location_type": {
      "type": "string",
      "description": "Freestanding home, townhouse/cluster, apartment/MDU or business premises."
    },
    "street_number": {
      "type": "string",
      "description": "Street number for the installation."
    },
    "street_name": {
      "type": "string",
      "description": "Street name for the installation."
    },
    "custom_address_name": {
      "type": "string",
      "description": "Optional customer label for this address."
    },
    "coverage_result": {
      "type": "string",
      "enum": [
        "covered",
        "near",
        "not_covered",
        "unknown"
      ],
      "description": "Legacy coverage outcome retained for earlier lead records."
    },
    "source": {
      "type": "string",
      "enum": [
        "coverage",
        "plans",
        "contact",
        "direct",
        "whatsapp"
      ],
      "default": "direct",
      "description": "Where the lead originated in the experience."
    },
    "message": {
      "type": "string",
      "description": "Optional free-text message from the contact form."
    },
    "consent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the lead consented to be contacted."
    },
    "utm": {
      "type": "string",
      "description": "Optional marketing context (e.g. utm_source/medium/campaign)."
    }
  },
  "required": [
    "name",
    "phone",
    "consent"
  ]
}